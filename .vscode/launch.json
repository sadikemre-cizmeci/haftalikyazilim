{
  "version": "0.2.0",
  "//": "F5 ile uygulamayı başlat. 'build' görevini (tasks.json) çalıştırıp sonra siteyi açar.",
  "configurations": [
    {
      "name": "HaftalıkYazılım (web)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/HaftalikYazilim.Web/bin/Debug/net10.0/HaftalikYazilim.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/HaftalikYazilim.Web",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    }
  ]
}
